# ---------------------------------------------------------------------------
# store_core (ERPNext side) secrets.
# Frappe reads these from the environment of the bench processes first, then from
# sites/<site>/site_config.json (lower-case keys). Set them with, for example:
#   bench --site <site> set-config lamsa_revalidate_secret "<random-64-chars>"
# Never store secrets in DocTypes. The storefront's own variables are in storefront/.env.example.
# ---------------------------------------------------------------------------

# Storefront ISR revalidation webhook (must match REVALIDATE_SECRET in storefront/.env)
LAMSA_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
LAMSA_REVALIDATE_SECRET=

# Meta Conversions API (server-side Purchase events, deduplicated with the Pixel)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional, only while testing in Events Manager
META_CAPI_TEST_EVENT_CODE=

# WhatsApp Business Cloud API (order status messages)
# Register one approved Arabic template per key of providers/notifications/templates.py
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Testing only: send the rendered text instead of an approved template. Meta delivers that
# only inside the 24-hour customer service window, so leave it empty in production.
WHATSAPP_FREE_TEXT=

# Moamalat card payments (Lightbox). Add "moamalat" to Lamsa Settings > Enabled Payment
# Providers and set an Online Payment Account there before switching MOAMALAT_ENV to live.
MOAMALAT_MERCHANT_ID=
MOAMALAT_TERMINAL_ID=
# hex, from the merchant portal
MOAMALAT_SECRET_KEY=
MOAMALAT_ENV=test

# Search by image, running on this server (pip install onnxruntime pillow)
# Point this at a CLIP *vision* encoder exported to ONNX, then enable it in Lamsa Settings and run
#   bench --site <site> execute store_core.services.image_search.reindex_all
LAMSA_IMAGE_MODEL_PATH=
LAMSA_IMAGE_MODEL_NAME=clip-vit-b-32-vision

# Sadad wallet: still a stub, needs its merchant API guide (see providers/payments/sadad.py)
SADAD_API_KEY=
SADAD_MERCHANT_ID=
SADAD_BASE_URL=
