# ---------------------------------------------------------------------------
# Lamsa storefront environment. Copy to .env.local (dev) or .env.production.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and never reach the browser.
# ---------------------------------------------------------------------------

# Public URL of this storefront (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://lamsa.ly

# ERPNext connection (server-only). On the same VPS use gunicorn directly:
ERP_BASE_URL=http://127.0.0.1:8000
# Frappe site name (needed when ERP_BASE_URL is an IP/port, not the site domain)
ERP_SITE_NAME=erp.lamsa.ly
# From: bench --site <site> execute store_core.setup.install.bootstrap
ERP_API_KEY=
ERP_API_SECRET=
ERP_TIMEOUT_MS=15000

# Public host serving ERPNext product images (/files/...)
NEXT_PUBLIC_ERP_PUBLIC_URL=https://erp.lamsa.ly

# Shared secret ERPNext uses to call POST /api/revalidate
# (same value as LAMSA_REVALIDATE_SECRET / lamsa_revalidate_secret on the ERPNext side)
REVALIDATE_SECRET=

# Marketing
NEXT_PUBLIC_META_PIXEL_ID=
# Fallback WhatsApp number (digits, e.g. 218912345678); Lamsa Settings wins when set
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Rate limits for the public API routes (per client IP)
RATE_LIMIT_CHECKOUT_PER_10MIN=5
RATE_LIMIT_TRACK_PER_5MIN=10
RATE_LIMIT_QUOTE_PER_MIN=60

# Local development without ERPNext (sample catalog, in-memory orders)
ERP_MOCK=0
